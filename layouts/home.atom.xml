{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
{{- /* Dates go through safeHTML, or the template escapes the + of the time zone. */}}
{{- /* 10 entries, as the Jekyll feed had: older posts must not reappear as new in feed readers.
     The content is escaped once by transform.XMLEscape; safeHTML stops the template from escaping it a second time. */}}
{{- $posts := first 10 (where site.RegularPages "Section" "posts") }}
<feed xmlns="http://www.w3.org/2005/Atom">
  <link href="{{ "feed.xml" | absURL }}" rel="self" type="application/atom+xml"/>
  <link href="{{ site.Home.Permalink }}" rel="alternate" type="text/html"/>
  <updated>{{ (index $posts 0).Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</updated>
  <id>{{ site.Params.feedIDBase }}feed.xml</id>
  <title type="html">{{ site.Title }}</title>
  <subtitle>{{ site.Params.description }}</subtitle>
  <author><name>{{ site.Params.author.name }}</name></author>
  {{- range $posts }}
  <entry>
    <title type="html">{{ .Title }}</title>
    <link href="{{ .Permalink }}" rel="alternate" type="text/html" title="{{ .Title }}"/>
    <published>{{ .Date.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</published>
    <updated>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</updated>
    <id>{{ site.Params.feedIDBase }}{{ strings.TrimPrefix "/" (strings.TrimSuffix ".html" .RelPermalink) }}</id>
    {{- /* feed readers get neither the site's CSS nor its script: drop the ## heading links and the code bar's
         language and copy button, and write callout numbers as text, as the Jekyll feed did */}}
    {{- $html := replaceRE `<a class="hm"[^>]*>.*?</a>` "" (string .Content) }}
    {{- $html = replaceRE `<div class="code-bar"[^>]*><span class="fname">(.*?)</span>.*?</div>` "<p><strong>$1</strong></p>" $html }}
    {{- $html = replaceRE `<div class="code-bar"[^>]*>.*?</div>` "" $html }}
    {{- $html = replaceRE `<span class="co" data-n="(\d+)"></span>` " ($1)" $html }}
    {{- /* these patterns follow the markup of the render hooks: fail the build when a hook changes and they stop matching */}}
    {{- $page := .RelPermalink }}
    {{- with findRE `class="(hm|code-bar|fname|lang|copy|co)"` $html 1 }}
    {{- errorf "feed.xml: %s still has %s after the cleanup, update the patterns in layouts/home.atom.xml" $page (index . 0) }}
    {{- end }}
    <content type="html" xml:base="{{ .Permalink }}">{{ $html | transform.XMLEscape | safeHTML }}</content>
    <author><name>{{ site.Params.author.name }}</name></author>
    {{- range .Params.tags }}
    <category term="{{ . }}"/>
    {{- end }}
    <summary type="html">{{ .Description }}</summary>
  </entry>
  {{- end }}
</feed>
